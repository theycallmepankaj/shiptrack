PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/shiptrack
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=change-me-internal
CLOUDINARY_URL=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
# Razorpay TEST keys (dashboard → Test mode → API keys). Empty = built-in mock checkout (development only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret for POST /api/payments/webhook (events: payment.captured, payment.failed)
RAZORPAY_WEBHOOK_SECRET=
# Unpaid bookings are cancelled after this many minutes
PAYMENT_TIMEOUT_MIN=30
# Seeds the demo accounts on startup when not in production
SEED_DEMO=true
MAIL_FROM="ShipTrack <no-reply@shiptrack.dev>"
# Geocoding (FR-10). Public Nominatim allows max 1 req/s and needs an identifying User-Agent.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=ShipTrack/0.1 (courier tracking demo)
GEOCODER_COUNTRY=in
# Public origin of this API (used for locally stored upload URLs)
PUBLIC_URL=http://localhost:5000
OTP_SECRET=change-me-otp
# Proof-of-delivery storage: Cloudinary when set (cloudinary://key:secret@cloud), else ./uploads
CLOUDINARY_URL=
