MONGO_URI=mongodb://localhost:27017/shiptrack
INTERNAL_API_KEY=change-me-internal
NODE_API_URL=http://localhost:5000
# Where the trained ETA model is stored (python -m app.ml.train_eta writes it)
MODEL_PATH=app/ml/model.pkl
# Promise the Nth percentile of predicted delivery time (0.5–0.99). Higher = more on-time, longer promises.
PROMISE_QUANTILE=0.85
# RAG chatbot (Milestone 8)
# Claude API key — without it the bot quotes the matching policy text instead of writing an answer.
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
# Local ONNX embeddings (no key). "hashing" = lexical fallback, no model download.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# local = cosine in this service (any MongoDB); atlas = Atlas Vector Search (create the index: python -m app.rag.setup_index)
VECTOR_SEARCH=local
# Below this best-match score the bot says it isn't sure (0 = the embedder's calibrated default)
RAG_MIN_SCORE=0
# "production" enables startup safety checks (e.g. a real INTERNAL_API_KEY)
APP_ENV=development
